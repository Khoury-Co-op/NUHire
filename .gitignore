# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. The example files are documentation, not secrets, and every setup
# path in ONBOARDING.md copies them, so they must stay tracked. Without the
# negations below `.env*` swallowed both and a clean clone could not start.
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules/

# Certificates and keys
*.crt
*.key
*.p12
*.jks
certs/
certificates/
secrets/

# API keys and sensitive config
config/secrets/
api/dist/

# File-sync conflict copies. iCloud and Dropbox resolve a conflict by writing
# "app 2.js" next to "app.js"; seven of those inside .next/types were enough to
# make `npm run typecheck` fail on errors that had nothing to do with the source.
# The leading space is what makes this safe: it will not match `sample1.js`.
* [0-9].*
