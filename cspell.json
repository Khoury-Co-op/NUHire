{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  // British and American spellings are both accepted: the docs use "behaviour"
  // and "summarise" on purpose.
  "language": "en,en-GB",
  "ignorePaths": [
    "**/node_modules/**",
    "**/package-lock.json",
    "**/dist/**",
    "**/.next/**",
    // Archived docs are not maintained; Prettier skips them too.
    "docs/archive/**",
    // Generated by Keycloak's export, full of its own setting names.
    "**/realm-export.json",
    "frontend/public/**"
  ],
  // Real names and terms in this project. Add a word here only if it is spelled
  // correctly; a typo belongs in the file, fixed.
  "words": [
    "Aaguids",
    "ACMR",
    "Aarav",
    "apicode",
    "Carbonite",
    "checkint",
    "cookieless",
    "creds",
    "crns",
    "currentpage",
    "curveball",
    "curveballs",
    "Cygilant",
    "dbmate",
    "dedupe",
    "destructures",
    "endgroup",
    "Excalidraw",
    "exlinc",
    "Fconfig",
    "FERPA",
    "Fisch",
    "forgeable",
    "gradebook",
    "groupsinfo",
    "healthcheck",
    "HMAC",
    "ibfk",
    "IDOR",
    "interviewpage",
    "interviewstreet",
    "jobdes",
    "jobdescription",
    "Khoury",
    "Lockfiles",
    "LTWH",
    "LTWHP",
    "makeofferpage",
    "mkdirs",
    "modestbranding",
    "Motionlogic",
    "mysqladmin",
    "mysqld",
    "mysqldump",
    "navbars",
    "navpanes",
    "nosniff",
    "nuhire",
    "nvmrc",
    "Nyugen",
    "Pandployer",
    "panployer",
    "Coolify",
    "coderabbit",
    "Pumba",
    "Toxiproxy",
    "pnuhire",
    "pipefail",
    "refetches",
    "resumepage",
    "roleplay",
    "sagashrimproll",
    "sendpopups",
    "sessionless",
    "showinfo",
    "signupform",
    "SUBDIRS",
    "timespent",
    "tinyint",
    "typechecks",
    "Unconfirm",
    "unparseable",
    "unpoliced",
    "upserts",
    "uroot",
    "userloading",
    "varchar",
    "vitest",
    "yourinitials",
    "youtu",
    "Zaclabit",
    "Zhiyuan"
  ],
  // The landing page spells out the acronym one letter per line ("N" +
  // "ortheastern", "U" + "niversity's"...), so the rest of each word stands alone.
  "ignoreWords": [
    "ortheastern",
    "niversity's",
    "iring",
    "nterviewing",
    "ecruiting",
    "xercise",
    // The old, misspelled /employerPannel route, quoted in TICKETS.md's record of the fix.
    "Pannel"
  ]
}
