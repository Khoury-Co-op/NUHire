# Copy to frontend/.env.local to run the frontend on the host. `npm run all`
# reads this file directly and then frontend/.env.local on top if present, so
# put local overrides there.

NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# No longer read by any source file — about/ and instructions/ use router.push
# now. Kept so an older checkout does not break. Safe to drop.
NEXT_PUBLIC_FRONT_URL=http://localhost:3000
