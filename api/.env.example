# Copy to api/.env to run the API on the host. `npm run all` reads this file
# directly and then api/.env on top if present, so put local overrides there.
# Values below are the local-dev defaults that work with
# .local/compose.yaml. Never commit the real .env.

# MySQL from .local/compose.yaml (note port 3307 on the host)
DATABASE_URL=mysql://root:nuhire@127.0.0.1:3307/nuhire

BACKEND_PORT=5001

# Any random string locally, but the API now refuses to boot if this is unset or
# shorter than 32 characters: an unset value signed every session cookie with
# `undefined`, which makes them forgeable. Generate a real one for deploys:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=local-dev-session-secret-change-me

# Where the frontend lives. Used for CORS and post-login redirects.
REACT_APP_FRONT_URL=http://localhost:3000

# Keycloak. Must be reachable at this URL from BOTH the browser and this process.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=NUHire-Realm
KEYCLOAK_CLIENT_ID=NUHire-Client
# cspell:disable-next-line
KEYCLOAK_CLIENT_SECRET=thJZ4vpuH8ch3cEEvfplB0X9CjOuhXgD
KEYCLOAK_CALLBACK_URL=http://localhost:5001/auth/keycloak/callback

# Second, legacy auth system gating /mod-dashboard (the page that grants
# teacher access). Scheduled for removal. If these are unset the endpoint
# currently accepts an empty body, so set them.
MODERATOR_USERNAME=admin
MODERATOR_PASSWORD=admin

# Browsers drop Secure cookies over plain http, so local dev must set this to
# false. Leave it UNSET in deploys to keep secure + sameSite=none.
COOKIE_SECURE=false

# Database pool tuning. All optional; the defaults are what runs in class.
#
# DB_POOL_SIZE is per process, so it is also the ceiling on concurrent queries.
# DB_POOL_QUEUE_LIMIT must stay finite: at 0 mysql2 queues acquires forever, so
# a saturated pool produced requests that never resolved and never errored, and
# 30 laptops span while the logs looked perfectly healthy. Past this many
# waiters the API returns 503 instead. Watch /health/db for `queued` above 0.
DB_POOL_SIZE=25
DB_POOL_QUEUE_LIMIT=30
DB_CONNECT_TIMEOUT_MS=10000
# Applied as MySQL's max_execution_time, which caps read-only SELECTs only.
DB_QUERY_TIMEOUT_MS=15000

# How many replicas of this API are running. Leave at 1.
#
# The socket layer keeps online students in process memory and Socket.IO has no
# room adapter, so with two replicas a group splits across them and each half
# misses the other's events. The API logs a loud error at boot if this is
# above 1; it cannot enforce it, so the Coolify service must also stay at 1.
INSTANCE_COUNT=1

# Reject Socket.IO connections that carry no login session.
#
# On unless set to false, so a deploy that leaves it unset is protected. Every
# socket event decides what the sender may do from their login, and a socket
# without one is the client none of those checks can see.
#
# Only the exact string false turns it off, and that is not a rollback. It lets
# sockets with no login connect, but every student event (check, checkint,
# moveGroup, confirmOffer, sentPresetVotes, makeOfferRequest,
# userCompletedResReview) still needs a login, so checkbox sync and moving the
# group to the next page stay off. If the login cookie stops reaching the socket,
# redeploy the previous version.
SOCKET_AUTH_REQUIRED=true

# Optional overrides for the simulated-class scripts (`npm run seed`, see
# .local/tests/README.md). They read this file for everything else and only run
# against localhost. The defaults are the values .local/compose.yaml sets.
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# SEED_API_URL=http://localhost:5001
